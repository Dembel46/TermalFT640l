<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Базовый контейнер видеопотоков -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 1. Слот оптики -->
        <FrameLayout
            android:id="@+id/opticalContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000">

            <androidx.camera.view.PreviewView
                android:id="@+id/pvPhoneCamera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:implementationMode="compatible" />
        </FrameLayout>

        <!-- 2. Слот тепловизора -->
        <FrameLayout
            android:id="@+id/thermalContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000">

            <TextureView
                android:id="@+id/svUvcCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </FrameLayout>

    <!-- Слой прицела, трекера и шкалы прозрачности -->
    <com.example.thermalcapture.CrosshairView
        android:id="@+id/crosshairOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ВЕРХНЯЯ ЛЕВАЯ ПАНЕЛЬ: Кнопка полноэкранного режима и статус -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnThermalFullscreen"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:backgroundTint="#80000000"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="⛶"
            android:textColor="#00FF00"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#99000000"
            android:padding="6dp"
            android:text="Ожидание подключения..."
            android:textColor="#00FF00"
            android:textSize="11sp" />

        <!-- Индикатор статуса видеозаписи (REC) -->
        <TextView
            android:id="@+id/tvRecordIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#CC990000"
            android:padding="6dp"
            android:text="РЕЖИМ: ЦИКЛ (3м)"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ВЕРХНЯЯ ПРАВАЯ ПАНЕЛЬ: Кнопка-Шестеренка (⚙) настроек -->
    <Button
        android:id="@+id/btnSettings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="10dp"
        android:backgroundTint="#80000000"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="⚙"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ЛЕВЫЙ ВЫДВИЖНОЙ БАР (SIDEBAR) -->
    <LinearLayout
        android:id="@+id/leftSidebar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Контейнер кнопок бара -->
        <LinearLayout
            android:id="@+id/sidebarContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#CC111111"
            android:orientation="vertical"
            android:padding="6dp">

            <Button
                android:id="@+id/btnMode"
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:layout_marginBottom="4dp"
                android:backgroundTint="#333333"
                android:text="70/30"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnCalibrate"
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:layout_marginBottom="4dp"
                android:backgroundTint="#333333"
                android:text="ЮСТИРОВКА"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnTracking"
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:layout_marginBottom="4dp"
                android:backgroundTint="#444444"
                android:text="ТРЕК: ВЫКЛ"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnPhoto"
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:layout_marginBottom="4dp"
                android:backgroundTint="#0077CC"
                android:text="ФОТО 📷"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnRecord"
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:layout_marginBottom="4dp"
                android:backgroundTint="#B71C1C"
                android:text="ЗАПИСЬ ⏺"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <!-- Кнопка повторного опроса USB устройств -->
            <Button
                android:id="@+id/btnRescanUsb"
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:backgroundTint="#2E7D32"
                android:text="ОПРОС USB ⟳"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Ярлычок скрытия/открытия панели -->
        <Button
            android:id="@+id/btnToggleSidebar"
            android:layout_width="26dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:backgroundTint="#AA222222"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="◀"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- НИЖНЯЯ ПАНЕЛЬ: Только ЗУМ, ПАЛИТРА и ГИБРИД -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnZoom"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#1976D2"
            android:text="ЗУМ: 0x"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnContrastType"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#6A1B9A"
            android:text="КОНТРАСТ: БЕЛЫЙ"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnHybrid"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#444444"
            android:text="ГИБРИД"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
